{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "brewfather-mcp",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "vars": {
    // Your Worker's public URL, no trailing slash. Shown after the first deploy.
    "PUBLIC_URL": "https://brewfather-mcp.REPLACE.workers.dev"
  },
  "kv_namespaces": [
    // Replace with the id from: wrangler kv namespace create OAUTH_KV
    { "binding": "OAUTH_KV", "id": "a87db99052224ab1baf82d8ae4ab7188" }
  ]
  // Secrets (set with `wrangler secret put <NAME>`, never commit):
  //   BREWFATHER_USER_ID, BREWFATHER_API_KEY, ACCESS_PASSPHRASE
}
